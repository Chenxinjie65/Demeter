# =============================================================================
# Demeter Protocol — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================


# =============================================================================
# REQUIRED — Signing key
# =============================================================================

# Private key of the account that will broadcast all deployment transactions.
# This account pays for gas and is set as the initial owner / role holder
# for all protocol contracts. Rotate to a multisig after deployment.
#
# Format: 0x-prefixed 64-hex-character private key
# Example (DO NOT USE — Foundry well-known dev key):
#   DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DEPLOYER_PRIVATE_KEY=


# =============================================================================
# REQUIRED — RPC endpoints
# =============================================================================

# Ethereum mainnet RPC (e.g. Alchemy / Infura / your own node).
MAINNET_RPC_URL=

# Sepolia testnet RPC (required for testnet deployment and fork tests).
SEPOLIA_RPC_URL=


# =============================================================================
# REQUIRED — Block explorer API key (for --verify flag)
# =============================================================================

# Etherscan API key — used for both mainnet and Sepolia verification.
# Obtain at: https://etherscan.io/myapikey
# For other chains use the relevant explorer's API key and update foundry.toml.
ETHERSCAN_API_KEY=


# =============================================================================
# V2 immutable core deployment and Timelock wiring
# =============================================================================

# Existing OpenZeppelin TimelockController and emergency guardian.
V2_TIMELOCK=
V2_GUARDIAN=

# Standard ERC-20 used as the registry-wide Uniswap V3 TWAP quote asset.
V2_COMMON_QUOTE_ASSET=

# Output addresses from DeployV2Core.s.sol.
V2_MANAGER=
V2_INDEX_POLICY=
V2_AUCTION_REBALANCE=

# Timelock proposer's and executor's signing keys. These may be the same key
# only when that matches the reviewed Timelock role configuration.
TIMELOCK_PROPOSER_PRIVATE_KEY=
TIMELOCK_EXECUTOR_PRIVATE_KEY=
V2_WIRING_SALT=


# =============================================================================
# V2 permissionless pool creation and bootstrap
# =============================================================================

POOL_CREATOR_PRIVATE_KEY=
POOL_BOOTSTRAPPER_PRIVATE_KEY=
V2_POOL_ASSETS=
V2_POOL_SEED_AMOUNTS=
V2_POLICY_FAMILY_ID=
V2_POOL_CREATOR_SALT=
V2_POOL_MANAGED=true
V2_POOL_NAME=
V2_POOL_SYMBOL=
V2_POOL_BOOTSTRAPPER=
V2_POOL_BOOTSTRAP_DEADLINE=
V2_POOL_INITIAL_SHARE_SUPPLY=
V2_POOL_SHARE_RECIPIENT=

# Output from CreateV2Pool.s.sol, used by ActivateAndBootstrapV2Pool.s.sol.
V2_POOL_ID=

# Comma-separated BPS array in the same strictly ascending order as assets.
V2_POLICY_WEIGHTS_BPS=
V2_POLICY_EPOCH=
V2_POLICY_EFFECTIVE_AT=
V2_POLICY_MIN_PLAN_INTERVAL=
V2_POLICY_PLAN_DURATION=
V2_POLICY_TRIGGER_BPS=
V2_POLICY_DESTINATION_BPS=
V2_POLICY_MAX_TURNOVER_BPS=
V2_POLICY_MAX_ASSET_ADJUSTMENT_BPS=
V2_POLICY_START_PREMIUM_BPS=
V2_POLICY_MAX_DISCOUNT_BPS=
V2_POLICY_AUCTION_DURATION=
V2_POLICY_MAX_ORACLE_DEVIATION_BPS=
V2_POLICY_MAX_REFERENCE_MOVE_BPS=


# =============================================================================
# OPTIONAL — Role addresses (default to DEPLOYER if unset)
# =============================================================================

# Address of the emergency guardian (can pause deposits and rebalancing).
# Recommended: a hardware-wallet or Safe multisig address.
# Default: deployer address
GUARDIAN_ADDRESS=

# Address of the risk admin (can add/remove oracle feeds and whitelist assets).
# Default: deployer address
RISK_ADMIN_ADDRESS=

# Address of the treasury (receives protocol management and performance fees).
# Default: deployer address
TREASURY_ADDRESS=


# =============================================================================
# OPTIONAL — CreateFund.s.sol parameters
# =============================================================================

# Address of the deployed DemeterFactory.
# Output by Deploy.s.sol and saved in deployments/<chainId>.json.
FACTORY_ADDRESS=

# Address that will act as the vault manager (can rebalance and update weights).
# Default: deployer address
FUND_MANAGER_ADDRESS=

# ERC-20 name for the vault's share token.
# Default: "Demeter Index"
FUND_NAME=Demeter Index

# ERC-20 symbol for the vault's share token.
# Default: "DMT"
FUND_SYMBOL=DMT

# Aave V3 RewardsController address (set to enable reward claiming).
# Leave empty / address(0) if rewards are not available on this network.
# Ethereum mainnet: not active (leave blank).
# Polygon: 0x929EC64c34a17401F460460D4B9390518E5B473e
AAVE_REWARDS_CONTROLLER=
